{
  "name": "clinic-opd-system",
  "version": "9.0.18",
  "private": true,
  "description": "简易门诊一体化系统（PHP 7.x + SQLite + 原生 JS/CSS，无 Composer）",
  "scripts": {
    "dev": "${FRANKENPHP:-$HOME/.local/bin/frankenphp} php-server --root public/ --listen 0.0.0.0:${PORT:-8000}",
    "start": "${FRANKENPHP:-$HOME/.local/bin/frankenphp} php-server --root public/ --listen 0.0.0.0:${PORT:-8000}",
    "lint": "${FRANKENPHP:-$HOME/.local/bin/frankenphp} php-cli tools/lint/php-lint.php",
    "server:ensure": "${FRANKENPHP:-$HOME/.local/bin/frankenphp} php-cli tools/lint/php-server-check.php"
  }
}
