# ============================================================
# 简易门诊一体化系统 — Nginx 配置示例（PHP 7.x）
# ============================================================
# 使用方法：
#   1. 将本文件复制为 /etc/nginx/conf.d/clinic.conf（或站点配置）
#   2. 修改 server_name、root 为实际域名与项目路径
#   3. root 指向项目的 public 目录（唯一 Web 入口）
#   4. 重启 Nginx：nginx -s reload
#
# ---- Session 高性能部署建议（Files 驱动 /tmpfs 内存盘挂载）----
# 系统默认使用 files 会话驱动（Session 文件写入 data/session/）。
# 单机高并发场景下，推荐将 Session 目录挂载到 tmpfs 虚拟内存盘，
# 消除物理磁盘 I/O 损耗（大屏轮询/危急值心跳等高频只读接口已通过
# Session::closeReadOnly() 释放独占锁，配合内存盘可显著降低 TTFB）：
#
#   mkdir -p /tmp/php-session && chmod 0777 /tmp/php-session
#   mount -t tmpfs -o size=64m,mode=0777 tmpfs /tmp/php-session
#   # 系统设置中配置 PHP session.save_path = /tmp/php-session
#
# 多机负载均衡/集群部署：可切换 Redis / Memcached 会话驱动（环境变量
# SESSION_DRIVER=redis|memcached，见 README「Session 存储架构」），
# 会话跨节点共享；未配置或连接失败时系统自动降级 files，不会白屏。
# ============================================================

server {
    listen 80;
    server_name your-domain.com;

    # Web 根目录指向 public（app/、data/ 均位于其外，天然不可访问）
    root /path/to/project/public;
    index index.php;

    # 站点字符集
    charset utf-8;

    # 上传大小限制（医院 LOGO / 用户照片）
    client_max_body_size 10m;

    # ---------- 静态资源缓存 ----------
    location ~* \.(css|js|png|jpg|jpeg|gif|webp|svg|ico)$ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # ---------- 主路由：所有动态请求转发单入口 index.php ----------
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # ---------- PHP-FPM（PHP 7.x） ----------
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_pass 127.0.0.1:9000;      # 按实际 PHP-FPM 监听地址修改
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param SCRIPT_NAME $fastcgi_script_name;
        fastcgi_index index.php;
        fastcgi_read_timeout 120;
    }

    # ---------- 双保险：禁止直接访问敏感目录（即使误放于 public 内） ----------
    location ~ ^/(app|data|\.git|\.env) {
        deny all;
    }

    # ---------- 禁止直接访问医院 LOGO 文件 ----------
    # 页面内 LOGO 以 base64 Data URI 内联显示（不引用 URL），
    # 此处同步封禁直链，防止通过 URL 探测/抓取 LOGO 文件
    location ~ ^/uploads/logo/ {
        deny all;
    }

    # ---------- 隐藏文件 ----------
    location ~ /\. {
        deny all;
    }

    # 访问日志 / 错误日志（按需开启）
    # access_log /var/log/nginx/clinic.access.log;
    # error_log  /var/log/nginx/clinic.error.log;
}
